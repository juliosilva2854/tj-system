# Backend Dockerfile - Gestao TJ (Railway Ready - 100% Standalone)
# Sistema funciona SEM dependências do Emergent
# Railway build context = raiz do repositório

FROM python:3.12-slim

# Railway 2025 recommended environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libxml2-dev libxslt1-dev \
    libjpeg-dev zlib1g-dev \
    libfreetype6-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements do backend/
COPY backend/requirements.txt ./requirements.txt

# Install Python dependencies (SEM emergentintegrations)
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy código do backend/ para /app
COPY backend/ ./

# Railway injeta PORT via environment variable
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:${PORT:-8001}/api/health || exit 1

# Start command com PORT dinâmico
CMD ["sh", "-c", "python -m uvicorn server:app --host 0.0.0.0 --port ${PORT:-8001} --workers 2"]